# Docker production setup — copy to .env before: docker compose up --build

NODE_ENV=production

# REQUIRED — strong random secrets (min 16 chars, not placeholders)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# REQUIRED — AI test generation depends on Gemini (not Playwright)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-here

# Playwright runs inside container — always headless in Docker
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0

# Page-aware explore
MAX_EXPLORE_HOPS=15
EXPLORE_TIMEOUT_MS=180000

# Do NOT enable in production — dev-only basic fallback when Gemini unavailable
# ALLOW_AI_FALLBACK=false
